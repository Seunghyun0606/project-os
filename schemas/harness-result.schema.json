{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project OS Harness Result",
  "type": "object",
  "required": ["version", "ok", "action", "data", "error"],
  "properties": {
    "version": {"const": 1},
    "ok": {"type": "boolean"},
    "action": {"type": "string", "minLength": 1},
    "data": {
      "oneOf": [
        {"type": "object"},
        {"type": "null"}
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string"}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    }
  },
  "additionalProperties": false
}
