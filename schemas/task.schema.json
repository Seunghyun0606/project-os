{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project OS Task",
  "type": "object",
  "required": ["id", "title", "role", "priority", "status", "objective", "acceptance"],
  "properties": {
    "id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9._-]+$"},
    "title": {"type": "string"},
    "role": {"type": "string"},
    "priority": {"type": "string"},
    "status": {"enum": ["planned", "ready", "active", "blocked", "done", "cancelled"]},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "array", "items": {"type": "string"}},
    "human_gate": {"type": "boolean"}
  }
}
