{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project OS Native Workflow",
  "type": "object",
  "required": ["id", "steps"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "task": {"type": "object"},
          "context": {"type": "object"},
          "approval_gate": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
