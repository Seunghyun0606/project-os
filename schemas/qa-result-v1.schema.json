{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-os.local/schemas/qa-result.schema.json",
  "title": "Project OS QA Run Result",
  "description": "Project-agnostic QA result contract consumed by agents and Remote Control.",
  "type": "object",
  "required": [
    "schema_version", "run_id", "project", "status", "started_at", "finished_at",
    "preflight", "build", "launch", "smoke", "functional", "ui",
    "artifact_collection", "cleanup", "errors", "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^QA-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "project": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "UI_REVIEW_REQUIRED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "preflight": {"$ref": "#/$defs/automatedStageStatus"},
    "build": {"$ref": "#/$defs/automatedStageStatus"},
    "launch": {"$ref": "#/$defs/automatedStageStatus"},
    "smoke": {"$ref": "#/$defs/automatedStageStatus"},
    "functional": {"$ref": "#/$defs/automatedStageStatus"},
    "ui": {"$ref": "#/$defs/uiStageStatus"},
    "artifact_collection": {"$ref": "#/$defs/automatedStageStatus"},
    "cleanup": {"$ref": "#/$defs/automatedStageStatus"},
    "next_action": {"enum": ["NONE", "FIX_AND_RETRY", "REQUEST_UI_REVIEW", "INVESTIGATE_ENVIRONMENT"]},
    "recommendation": {"type": "string"},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "preflight": {"enum": ["PASS", "SKIPPED"]},
          "build": {"enum": ["PASS", "SKIPPED"]},
          "launch": {"enum": ["PASS", "SKIPPED"]},
          "smoke": {"enum": ["PASS", "SKIPPED"]},
          "functional": {"enum": ["PASS", "SKIPPED"]},
          "ui": {"enum": ["PASS", "SKIPPED"]},
          "artifact_collection": {"enum": ["PASS", "SKIPPED"]},
          "cleanup": {"enum": ["PASS", "SKIPPED"]},
          "next_action": {"enum": ["NONE"]}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "UI_REVIEW_REQUIRED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "preflight": {"enum": ["PASS", "SKIPPED"]},
          "build": {"enum": ["PASS", "SKIPPED"]},
          "launch": {"enum": ["PASS", "SKIPPED"]},
          "smoke": {"enum": ["PASS", "SKIPPED"]},
          "functional": {"enum": ["PASS", "SKIPPED"]},
          "ui": {"const": "REVIEW_REQUIRED"},
          "artifact_collection": {"enum": ["PASS", "SKIPPED"]},
          "cleanup": {"enum": ["PASS", "SKIPPED"]},
          "next_action": {"const": "REQUEST_UI_REVIEW"}
        },
        "required": ["next_action"]
      }
    },
    {
      "if": {"properties": {"status": {"const": "FAIL"}}, "required": ["status"]},
      "then": {"properties": {"errors": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "automatedStageStatus": {"enum": ["PASS", "FAIL", "SKIPPED"]},
    "uiStageStatus": {"enum": ["PASS", "FAIL", "SKIPPED", "REVIEW_REQUIRED"]},
    "error": {
      "type": "object",
      "required": ["code", "message", "stage"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "stage": {"enum": ["preflight", "build", "launch", "smoke", "functional", "ui", "artifact_collection", "cleanup"]},
        "kind": {"enum": ["test", "environment", "tooling", "configuration", "unknown"]},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["type", "name", "path"],
      "properties": {
        "type": {"enum": ["screenshot", "video", "log", "report", "trace", "other"]},
        "name": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "scenario": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "media_type": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
